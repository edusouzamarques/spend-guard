{
  "on_missing": "block",
  "rules": {
    "text.generate": { "unit": "token", "per": 1000000, "unit_price": "3.00" },
    "text.embed": { "unit": "token", "per": 1000000, "unit_price": "0.13" },
    "speech.synthesise": {
      "unit": "character",
      "per": 1000,
      "unit_price": "0.30",
      "minimum": "0.01"
    },
    "image.render": { "unit": "image", "unit_price": "0.04" },
    "image.upscale": { "unit": "image", "unit_price": "0.01" },
    "video.render": { "unit": "second", "unit_price": "0.50" },
    "compute.gpu.*": { "unit": "hour", "unit_price": "0.90", "minimum": "0.05" },
    "storage.egress": { "unit": "gigabyte", "unit_price": "0.09" }
  }
}
